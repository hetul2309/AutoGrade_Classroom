# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://grader:grader_password@localhost:5432/notebook_grader

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Primary key (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Add more keys here if you rotate when one expires:
# ANTHROPIC_API_KEY_2=your-second-key-here

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
UPLOAD_DIR=./uploads

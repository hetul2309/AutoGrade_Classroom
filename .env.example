# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://grader:grader_password@localhost:5432/notebook_grader

# ── LLM Settings ─────────────────────────────────────────────────────────────
# Set provider to "gemini" for 100% Free grading or "anthropic" for Claude
LLM_PROVIDER=gemini

# ── Google Gemini API (100% FREE) ─────────────────────────────────────────────
# 1. Go to https://aistudio.google.com/
# 2. Click "Get API key" (no credit card required!)
# 3. Paste your key below.
# Note: Google Gemini API keys do NOT expire unless you manually delete them.
# Free limits: 15 requests/min, 1,500 requests/day, 1,000,000 tokens/min.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude API (Optional / Paid) ────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
UPLOAD_DIR=./uploads
